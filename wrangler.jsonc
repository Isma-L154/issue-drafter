{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "issue-drafter",
  "main": "src/index.ts",
  // Capped by the workerd bundled with @cloudflare/vitest-pool-workers: a newer
  // date makes the test runtime refuse to start.
  "compatibility_date": "2026-08-22",

  "routes": [{ "pattern": "issues.cloudils.com", "custom_domain": true }],

  // Only the Access-protected hostname serves the Worker.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "ai": { "binding": "AI" },

  "kv_namespaces": [{ "binding": "USAGE", "id": "27d3c9eb4aad482fb6f8d05ba2e526bf" }],

  "ratelimits": [
    { "name": "DRAFT_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "PUBLISH_LIMITER", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
    // Listing repositories spends up to five GitHub requests each time.
    { "name": "REPOS_LIMITER", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
  ],

  // Secret, set with `wrangler secret put GITHUB_TOKEN`, never committed.
  "vars": {
    "MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "GITHUB_OWNER": "Isma-L154",
    "SITE_ORIGIN": "https://issues.cloudils.com",
    // The Access application "Issue Drafter". Neither value is secret: both
    // appear in the login redirect. Empty values would make every
    // authenticated route refuse, so a missing Access setup fails closed.
    "ACCESS_TEAM_DOMAIN": "tiny-snow-e0a3.cloudflareaccess.com",
    "ACCESS_AUD": "da165935fa7365ae60b032a08c23f226eda0a51aa001117ae060ef6ec26cbe03",
    // 150 drafts at the worst measured cost stay under 10,000 daily Neurons.
    "DAILY_DRAFT_CAP": "150",
    "DAILY_PUBLISH_CAP": "50"
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
