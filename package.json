{
  "name": "issue-drafter",
  "version": "0.1.0",
  "private": true,
  "description": "Turns an informal Spanish note into an English GitHub issue from a fixed template.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run --no-watch",
    "eval": "node scripts/eval.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
