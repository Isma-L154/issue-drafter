{
  "name": "issue-drafter",
  "version": "0.1.0",
  "private": true,
  "description": "Turns an informal Spanish note into an English GitHub issue from a fixed template.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run --no-watch",
    "eval": "node scripts/eval.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "miniflare@5.20260815.0-alpha": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261001.1": true
  }
}
